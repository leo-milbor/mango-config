
# ===== Key bindings =====
# Key names per `wev`. Full dispatcher list:
# /usr/share/doc or github.com/DreamMaoMao/mango wiki

# Applications
bind=SUPER,t,spawn,ghostty
bindl=SUPER+ALT,l,spawn,swaylock
bind=SUPER+ALT,s,spawn_shell,pkill orca || exec orca

# Noctalia
bind=SUPER,space,spawn,noctalia msg panel-toggle launcher
bind=SUPER,s,spawn,noctalia msg panel-toggle control-center
bind=SUPER+SHIFT,s,spawn,noctalia msg settings-toggle
bind=ALT,Tab,spawn,noctalia msg window-switcher

# Overview
bind=SUPER,o,toggleoverview,

# Close / quit
bind=SUPER,q,killclient,
bind=SUPER+SHIFT,e,quit
bind=CTRL+ALT,Delete,quit

# Focus (Mod+arrows / Mod+hjkl)
bind=SUPER,Left,focusdir,left
bind=SUPER,Down,focusdir,down
bind=SUPER,Up,focusdir,up
bind=SUPER,Right,focusdir,right
bind=SUPER,h,focusdir,left
bind=SUPER,j,focusdir,down
bind=SUPER,k,focusdir,up
bind=SUPER,l,focusdir,right

# Move window (Mod+Ctrl+arrows / hjkl)
bind=SUPER+CTRL,Left,move_client,left
bind=SUPER+CTRL,Down,move_client,down
bind=SUPER+CTRL,Up,move_client,up
bind=SUPER+CTRL,Right,move_client,right
bind=SUPER+CTRL,h,move_client,left
bind=SUPER+CTRL,j,move_client,down
bind=SUPER+CTRL,k,move_client,up
bind=SUPER+CTRL,l,move_client,right

# Monitors (Mod+Shift / Mod+Shift+Ctrl)
bind=SUPER+SHIFT,Left,focusmon,left
bind=SUPER+SHIFT,Down,focusmon,down
bind=SUPER+SHIFT,Up,focusmon,up
bind=SUPER+SHIFT,Right,focusmon,right
bind=SUPER+SHIFT,h,focusmon,left
bind=SUPER+SHIFT,j,focusmon,down
bind=SUPER+SHIFT,k,focusmon,up
bind=SUPER+SHIFT,l,focusmon,right
bind=SUPER+SHIFT+CTRL,Left,tagmon,left
bind=SUPER+SHIFT+CTRL,Down,tagmon,down
bind=SUPER+SHIFT+CTRL,Up,tagmon,up
bind=SUPER+SHIFT+CTRL,Right,tagmon,right
bind=SUPER+SHIFT+CTRL,h,tagmon,left
bind=SUPER+SHIFT+CTRL,j,tagmon,down
bind=SUPER+SHIFT+CTRL,k,tagmon,up
bind=SUPER+SHIFT+CTRL,l,tagmon,right

# Workspaces (niri workspaces -> mango tags)
bind=SUPER,i,viewtoright,
bind=SUPER,u,viewtoleft,
bind=SUPER,Page_Down,viewtoright,
bind=SUPER,Page_Up,viewtoleft,
bind=SUPER+CTRL,u,tagtoright,
bind=SUPER+CTRL,i,tagtoleft,
bind=SUPER+CTRL,Page_Down,tagtoright,
bind=SUPER+CTRL,Page_Up,tagtoleft,

bind=SUPER,1,view,1
bind=SUPER,2,view,2
bind=SUPER,3,view,3
bind=SUPER,4,view,4
bind=SUPER,5,view,5
bind=SUPER,6,view,6
bind=SUPER,7,view,7
bind=SUPER,8,view,8
bind=SUPER,9,view,9
bind=SUPER+CTRL,1,tag,1
bind=SUPER+CTRL,2,tag,2
bind=SUPER+CTRL,3,tag,3
bind=SUPER+CTRL,4,tag,4
bind=SUPER+CTRL,5,tag,5
bind=SUPER+CTRL,6,tag,6
bind=SUPER+CTRL,7,tag,7
bind=SUPER+CTRL,8,tag,8
bind=SUPER+CTRL,9,tag,9

# Layouts
bind=SUPER,r,switch_proportion_preset,
bind=SUPER+SHIFT,r,reload_config
bind=SUPER,f,togglemaximizescreen,
bind=SUPER+SHIFT,f,togglefullscreen,
bind=SUPER,v,togglefloating,
bind=SUPER,c,centerwin,

# Scroller: move window in/out of the stack (approximates niri consume/expel)
bind=SUPER,bracketleft,scroller_stack,left
bind=SUPER,bracketright,scroller_stack,right

# Screenshot (mango has no built-in; noctalia annotator or grim work)
# bind=NONE,Print,spawn_shell,grim -g "$(slurp)" /tmp/shot.png && wl-copy < /tmp/shot.png

# Media keys (through noctalia)
bind=NONE,XF86AudioRaiseVolume,spawn,noctalia msg volume-up
bind=NONE,XF86AudioLowerVolume,spawn,noctalia msg volume-down
bind=NONE,XF86AudioMute,spawn,noctalia msg volume-mute
bind=NONE,XF86MonBrightnessUp,spawn,noctalia msg brightness-up
bind=NONE,XF86MonBrightnessDown,spawn,noctalia msg brightness-down
bind=NONE,XF86AudioMicMute,spawn_shell,wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bind=NONE,XF86AudioPlay,spawn,playerctl play-pause
bind=NONE,XF86AudioStop,spawn,playerctl stop
bind=NONE,XF86AudioPrev,spawn,playerctl previous
bind=NONE,XF86AudioNext,spawn,playerctl next
